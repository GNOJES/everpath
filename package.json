{
  "name": "everpath",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/game.spec.ts e2e/native-shell.spec.ts e2e/diagnostics.spec.ts e2e/campaign.spec.ts e2e/audio.spec.ts e2e/results.spec.ts e2e/backup.spec.ts",
    "test:playtest": "playwright test e2e/long-play.spec.ts",
    "test:balance": "vitest run tests/balance.test.ts",
    "android:doctor": "node scripts/android.mjs doctor",
    "android:sync": "node scripts/android.mjs sync",
    "android:apk": "node scripts/android.mjs build",
    "android:open": "cap open android",
    "android:install": "node scripts/android.mjs install",
    "test:campaign": "vitest run tests/campaign.test.ts tests/campaign-balance.test.ts tests/retry-economy.test.ts",
    "test:campaign-browser": "playwright test e2e/campaign-play.spec.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
